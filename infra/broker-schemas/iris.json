{
  "$schema": "https://fintekpro.in/schemas/broker-requirement-schema/v1",
  "broker_id": "iris",
  "broker_name": "KFintech IRIS",
  "schema_version": "1.0",
  "regulatory_regime": "SEBI_AMFI",
  "kra_reuse_eligible": true,
  "last_reviewed": "2026-06-25",
  "api_reference": "https://iris-api.kfintech.com/v2",
  "segments": {
    "mutual_funds": {
      "required_fields": [
        "full_legal_name",
        "date_of_birth",
        "pan_number",
        "mobile_number",
        "email",
        "current_address",
        "permanent_address",
        "bank_account_number",
        "ifsc_code",
        "nominee_details",
        "fatca_crs_classification",
        "occupation"
      ],
      "broker_unique_fields": [
        "iris_investor_id",
        "amc_folio_number",
        "mandate_id"
      ],
      "prefillable_from_kra": [
        "full_legal_name",
        "date_of_birth",
        "pan_number",
        "current_address",
        "permanent_address",
        "occupation"
      ],
      "always_required_delta": [
        "bank_account_number",
        "ifsc_code",
        "nominee_details",
        "fatca_crs_classification"
      ],
      "freshness_windows_days": {
        "address_proof": 180,
        "bank_details": 180,
        "pan_verification": 730
      },
      "field_mapping": {
        "full_legal_name": "investorName",
        "date_of_birth": "dob",
        "pan_number": "pan",
        "mobile_number": "mobile",
        "email": "email",
        "bank_account_number": "accountNo",
        "ifsc_code": "ifscCode",
        "occupation": "occupationCode",
        "fatca_crs_classification": "fatcaDeclaration"
      }
    },
    "fixed_deposits": {
      "required_fields": [
        "full_legal_name",
        "date_of_birth",
        "pan_number",
        "mobile_number",
        "email",
        "current_address",
        "bank_account_number",
        "ifsc_code",
        "nominee_details"
      ],
      "broker_unique_fields": [
        "fd_application_id",
        "fd_tenure_months"
      ],
      "prefillable_from_kra": [
        "full_legal_name",
        "date_of_birth",
        "pan_number",
        "current_address"
      ],
      "always_required_delta": [
        "bank_account_number",
        "ifsc_code",
        "nominee_details"
      ],
      "freshness_windows_days": {
        "bank_details": 180
      },
      "field_mapping": {
        "full_legal_name": "applicantName",
        "pan_number": "pan",
        "bank_account_number": "bankAccountNo",
        "ifsc_code": "ifsc"
      }
    }
  }
}

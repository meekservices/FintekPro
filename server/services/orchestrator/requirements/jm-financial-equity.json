    { "canonical_field": "gender",                  "required": true,  "prefillable_from_vault": true,  "freshness_window_days": null  },
    { "canonical_field": "panNumber",               "required": true,  "prefillable_from_vault": true,  "freshness_window_days": null  },
    { "canonical_field": "photoDocumentRef",        "required": true,  "prefillable_from_vault": true,  "freshness_window_days": 3650 },
    { "canonical_field": "signatureDocumentRef",    "required": true,  "prefillable_from_vault": true,  "freshness_window_days": 3650 },
    { "canonical_field": "mobileNumber",            "required": true,  "prefillable_from_vault": true,  "freshness_window_days": null  },
    { "canonical_field": "email",                   "required": true,  "prefillable_from_vault": true,  "freshness_window_days": null  },
    { "canonical_field": "currentAddress",          "required": true,  "prefillable_from_vault": true,  "freshness_window_days": 365  },
    { "canonical_field": "addressProofDocumentRef", "required": true,  "prefillable_from_vault": true,  "freshness_window_days": 365  },

    },
    {
      "field_id": "jm_esign_risk_disclosure",
      "label": "JM e-Sign & Risk Disclosure",
      "type": "esign",
      "required": true,
      "broker_note": "Bilateral e-sign with JM Financial specifically. Always fresh."
    },
    {
      "field_id": "jm_nominee_details",
      "label": "Nominee Details",
      "type": "object",
      "required": false,
      "broker_note": "Fresh per broker — not shared from vault."
    }

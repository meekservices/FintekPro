{
  // ─── TypeScript ───────────────────────────────────────────────────────────
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.preferences.importModuleSpecifier": "relative",
  "typescript.tsserver.maxTsServerMemory": 8192,

  // ─── Matt Pocock 'ts-error-translator' (mattpocock.ts-error-translator) ─────
  // This extension shows TypeScript tips with diagnostic codes like
  // 'interface-declaration', 'basic-types', 'union-type', etc.
  // Tips are suppressed via the settings below (confirmed valid keys):
  "totalTypeScript.hideAllTips": true,
  "totalTypeScript.hideBasicTips": true,
  // Completely disable diagnostic reporting to the Problems panel:
  "totalTypeScript.enabled": false,

  // ─── Editor ───────────────────────────────────────────────────────────────
  "editor.formatOnSave": false,
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },

  // ─── Python ───────────────────────────────────────────────────────────────
  // Point the IDE at the venv created inside the python service directory.
  // To create it: cd services/python && python3.12 -m venv .venv && pip install -r requirements.txt
  // Then reload the IDE window so this interpreter is picked up automatically.
  "python.defaultInterpreterPath": "${workspaceFolder}/services/python/.venv/bin/python",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/services/python"
  ],

  // ─── Tailwind CSS IntelliSense ────────────────────────────────────────────
  "tailwindCSS.experimental.configFile": "./tailwind.config.ts",
  "tailwindCSS.includeLanguages": {
    "typescript": "javascript",
    "typescriptreact": "javascript",
    "javascript": "javascript",
    "javascriptreact": "javascript"
  },
  "tailwindCSS.classAttributes": [
    "class",
    "className",
    "ngClass",
    "class:list",
    ".*ClassName",
    ".*Classes"
  ],
  "tailwindCSS.experimental.classRegex": [
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cn\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"]
  ],

  // ─── Docker ───────────────────────────────────────────────────────────────
  // Keep Compose validation quiet in this workspace; the project uses plain
  // docker compose files plus Cloud Run deployment scripts.
  "docker.extension.enableComposeLanguageServer": false,

  // ─── File exclusions ──────────────────────────────────────────────────────
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.git/**": true,
    "**/dist/**": true
  }
}

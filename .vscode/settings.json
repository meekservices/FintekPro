{
  // ─── TypeScript ───────────────────────────────────────────────────────────
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.preferences.importModuleSpecifier": "relative",
  "typescript.tsserver.maxTsServerMemory": 8192,

  // ─── Matt Pocock 'Total TypeScript' (mattpocock.ts-error-translator) ────────
  // The extension emits `info`-level diagnostics teaching TypeScript patterns.
  // `hiddenTips` is the ONLY setting that suppresses Problems-panel entries.
  // `hideAllTips` / `hideBasicTips` only affect the inline hover popup UI.
  // Listed here: every tip ID that appears in FintekPro source files.
  "totalTypeScript.hideAllTips": true,
  "totalTypeScript.hideBasicTips": true,
  "totalTypeScript.hiddenTips": [
    "type-alias-declaration",
    "interface-declaration",
    "ts-object-type",
    "basic-types",
    "optional-object-property",
    "array-type",
    "passing-generics-to-types",
    "any-type",
    "literal-type",
    "union-type",
    "null-keyword",
    "undefined-keyword",
    "variable-type-annotation",
    "typing-function-parameters",
    "function-return-type",
    "as-const",
    "as-assertion",
    "non-null-expression",
    "typeof",
    "keyof",
    "mapped-type",
    "conditional-type",
    "template-literal-type",
    "infer-keyword",
    "generic-slots",
    "type-predicate",
    "discriminated-union",
    "tuple-type",
    "readonly-array",
    "partial-type-helper",
    "required-type-helper",
    "record-type-helper",
    "extract-type-helper",
    "exclude-type-helper",
    "omit-type-helper",
    "pick-type-helper",
    "return-type-type-helper",
    "parameters-type-helper",
    "awaited-type-helper",
    "never-keyword",
    "generic-slots-in-functions",
    "generics",
    "object-type",
    "satisfies-keyword"
  ],

  // ─── Editor ───────────────────────────────────────────────────────────────
  "editor.formatOnSave": false,
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },

  // ─── Python ───────────────────────────────────────────────────────────────
  // Point the IDE at the venv created inside the python service directory.
  // To create it: cd services/python && python3.12 -m venv .venv && pip install -r requirements.txt
  // Then reload the IDE window so this interpreter is picked up automatically.
  "python.defaultInterpreterPath": "${workspaceFolder}/services/python/.venv/bin/python",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/services/python"
  ],

  // ─── Tailwind CSS IntelliSense ────────────────────────────────────────────
  "tailwindCSS.experimental.configFile": "./tailwind.config.ts",
  "tailwindCSS.includeLanguages": {
    "typescript": "javascript",
    "typescriptreact": "javascript",
    "javascript": "javascript",
    "javascriptreact": "javascript"
  },
  "tailwindCSS.classAttributes": [
    "class",
    "className",
    "ngClass",
    "class:list",
    ".*ClassName",
    ".*Classes"
  ],
  "tailwindCSS.experimental.classRegex": [
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cn\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"]
  ],

  // ─── Docker ───────────────────────────────────────────────────────────────
  // Keep Compose validation quiet in this workspace; the project uses plain
  // docker compose files plus Cloud Run deployment scripts.
  "docker.extension.enableComposeLanguageServer": false,

  // ─── File exclusions ──────────────────────────────────────────────────────
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.git/**": true,
    "**/dist/**": true
  }
}

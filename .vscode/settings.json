{
  // ─── Biome ────────────────────────────────────────────────────────────────
  // Points the VS Code Biome extension to the local node_modules binary.
  "biome.lsp.bin": "node_modules/@biomejs/biome/bin/biome",
  "biome.lspBin": "node_modules/@biomejs/biome/bin/biome",

  // ─── TypeScript Language Server High-Performance Tuning ────────────────────
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.preferences.importModuleSpecifier": "relative",
  "typescript.tsserver.maxTsServerMemory": 8192,
  "typescript.tsserver.useSeparateSyntaxServer": "forFullProject",
  "typescript.tsserver.experimental.enableProjectDiagnostics": false,
  "typescript.disableAutomaticTypeAcquisition": true,
  "typescript.suggest.paths": true,
  "typescript.suggest.autoImports": true,
  "typescript.preferences.includePackageJsonAutoImports": "off",

  // ─── Matt Pocock 'Total TypeScript' (mattpocock.ts-error-translator) ────────
  "totalTypeScript.hideAllTips": true,
  "totalTypeScript.hideBasicTips": true,
  "totalTypeScript.hiddenTips": [
    "type-alias-declaration",
    "interface-declaration",
    "ts-object-type",
    "basic-types",
    "optional-object-property",
    "array-type",
    "passing-generics-to-types",
    "any-type",
    "literal-type",
    "union-type",
    "null-keyword",
    "undefined-keyword",
    "variable-type-annotation",
    "typing-function-parameters",
    "function-return-type",
    "as-const",
    "as-assertion",
    "non-null-expression",
    "typeof",
    "keyof",
    "mapped-type",
    "conditional-type",
    "template-literal-type",
    "infer-keyword",
    "generic-slots",
    "type-predicate",
    "discriminated-union",
    "tuple-type",
    "readonly-array",
    "partial-type-helper",
    "required-type-helper",
    "record-type-helper",
    "extract-type-helper",
    "exclude-type-helper",
    "omit-type-helper",
    "pick-type-helper",
    "return-type-type-helper",
    "parameters-type-helper",
    "awaited-type-helper",
    "never-keyword",
    "generic-slots-in-functions",
    "generics",
    "object-type",
    "satisfies-keyword"
  ],

  // ─── Editor Rendering & Lag Reduction ──────────────────────────────────────
  "files.autoSave": "onFocusChange",
  "editor.formatOnSave": false,
  "editor.minimap.enabled": false,
  "editor.minimap.renderCharacters": false,
  "editor.renderWhitespace": "selection",
  "editor.renderControlCharacters": false,
  "editor.hover.delay": 350,
  "editor.smoothScrolling": false,
  "editor.cursorBlinking": "smooth",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },

  // ─── Search & Indexing Optimization ────────────────────────────────────────
  "search.followSymlinks": false,
  "search.useIgnoreFiles": true,
  "search.useGlobalIgnoreFiles": false,
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/coverage": true,
    "**/.git": true,
    "**/drizzle-migrations": true,
    "**/.antigravity": true,
    "**/package-lock.json": true,
    "**/*.log": true,
    "**/*.tsbuildinfo": true
  },

  // ─── File Watcher Memory & Disk I/O Throttling ─────────────────────────────
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.git/**": true,
    "**/dist/**": true,
    "**/coverage/**": true,
    "**/drizzle-migrations/**": true,
    "**/.antigravity/**": true,
    "**/services/python/.venv/**": true,
    "**/.turbo/**": true,
    "**/.cache/**": true
  },

  // ─── Git & SCM Optimization ────────────────────────────────────────────────
  "git.autorefresh": true,
  "git.autoStash": true,
  "git.fetchOnPull": true,
  "git.statusLimit": 5000,
  "git.decorations.enabled": true,

  // ─── Terminal GPU Acceleration ─────────────────────────────────────────────
  "terminal.integrated.gpuAcceleration": "auto",
  "terminal.integrated.fastScrollSensitivity": 5,

  // ─── Python ───────────────────────────────────────────────────────────────
  "python.defaultInterpreterPath": "${workspaceFolder}/services/python/.venv/bin/python",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/services/python"
  ],

  // ─── Tailwind CSS IntelliSense ────────────────────────────────────────────
  "tailwindCSS.experimental.configFile": "./tailwind.config.ts",
  "tailwindCSS.includeLanguages": {
    "typescript": "javascript",
    "typescriptreact": "javascript",
    "javascript": "javascript",
    "javascriptreact": "javascript"
  },
  "tailwindCSS.classAttributes": [
    "class",
    "className",
    "ngClass",
    "class:list",
    ".*ClassName",
    ".*Classes"
  ],
  "tailwindCSS.experimental.classRegex": [
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cn\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"]
  ],

  // ─── Docker ───────────────────────────────────────────────────────────────
  "docker.extension.enableComposeLanguageServer": false,

  // ─── Performance & Notification Hygiene ───────────────────────────────────
  "extensions.ignoreRecommendations": true
}

# Copy this to .env and fill in the values

# Port this service listens on
PORT=5001

# Must match SESSION_SECRET from the main FintekPro portal
SERVICE_JWT_SECRET=your_session_secret_here

# Shared Neon DB (same as main portal's DATABASE_URL)
DATABASE_URL=postgresql://...

# Turtlefin Insurance API
TURTLEFIN_API_KEY=
TURTLEFIN_API_SECRET=
TURTLEFIN_ENVIRONMENT=sandbox

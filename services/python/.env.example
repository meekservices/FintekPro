# ── Required ────────────────────────────────────────────────────────────────
# Same Neon/Postgres connection string as the main portal.
# Use the *pooled* URL (port 5432 / pgbouncer) for prod; direct for local dev.
PRODUCTION_DATABASE_URL=postgresql://user:pass@host/dbname

# Shared JWT secret — must match SESSION_SECRET on the main Node.js service.
# Every inbound request from the main portal carries a short-lived JWT signed
# with this secret.  The Python service verifies it in auth.py.
PYTHON_SERVICE_SECRET=your-session-secret-here

# ── Optional ─────────────────────────────────────────────────────────────────
# Set by Railway automatically — uvicorn listens on this port.
# PORT=8000

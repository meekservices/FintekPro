# ── Required ────────────────────────────────────────────────────────────────
# Same GCP Cloud SQL connection string as the main portal.
PRODUCTION_DATABASE_URL=postgresql://user:pass@host/dbname

# Shared JWT secret — must match SESSION_SECRET on the main Node.js service.
# Every inbound request from the main portal carries a short-lived JWT signed
# with this secret.  The Python service verifies it in auth.py.
PYTHON_SERVICE_SECRET=your-session-secret-here

# ── Optional ─────────────────────────────────────────────────────────────────
# Set by Cloud Run automatically — uvicorn listens on this port.
# PORT=8000

# ── Cloud SQL Unix Socket Fallback (Cloud Run only) ──────────────────────────
# When the Cloud SQL Unix socket is present, the service resolves credentials
# from PRODUCTION_DATABASE_URL first.  If the DSN contains a placeholder
# service-account name (e.g. fintekpro_user / fintekpro_db), these env-vars
# are used instead.  Set them in your Cloud Run environment / Secret Manager.
# DB_FALLBACK_USER=postgres
# DB_FALLBACK_PASSWORD=your-postgres-superuser-password
# DB_FALLBACK_DBNAME=fintekpro

# FintekPro Environment Variables
# Copy this file to .env and fill in the values for local development.
# For Railway/production, set these in the Railway dashboard environment variables.

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Railway provides DATABASE_URL automatically)
PRODUCTION_DATABASE_URL=
DATABASE_URL=

# ─── Security ─────────────────────────────────────────────────────────────────
SESSION_SECRET=
ENCRYPTION_MASTER_KEY=

# ─── Node Environment ─────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
LOG_LEVEL=info

# ─── AI / Intelligence ────────────────────────────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=

# ─── Payment Gateways ─────────────────────────────────────────────────────────

# Cashfree (Primary)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENVIRONMENT=

# PhonePe (Secondary)
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=

# Stripe (International)
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLIC_KEY=

# ─── KYC & Verification ───────────────────────────────────────────────────────

# Sandbox.co.in (Bank verification / Penny Drop)
SANDBOX_API_KEY=
SANDBOX_API_SECRET=

# ─── Communication Services ───────────────────────────────────────────────────

# Email (SMTP / Nodemailer)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=

# SMS & WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Object Storage ───────────────────────────────────────────────────────────
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=

# ─── Social / OAuth (Optional) ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_SERVICE_ID=
APPLE_TEAM_ID=

# ─── Market Data (Optional) ───────────────────────────────────────────────────
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=

# ─── Python Service (Optional) ────────────────────────────────────────────────
PYTHON_SERVICE_URL=
PYTHON_BIN=

# FintekPro Environment Variables
# Copy this file to .env and fill in the values for local development.
# For production, set these in the GCP Cloud Run or Docker environment variables.

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string to GCP Cloud SQL
PRODUCTION_DATABASE_URL=

# ─── Security ─────────────────────────────────────────────────────────────────
SESSION_SECRET=
ENCRYPTION_MASTER_KEY=

# ─── Node Environment ─────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
LOG_LEVEL=info

# ─── AI / Intelligence ────────────────────────────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=

# ─── Payment Gateways ─────────────────────────────────────────────────────────

# Cashfree (Primary)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENVIRONMENT=

# PhonePe (Secondary)
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=

# Stripe (International)
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLIC_KEY=

# ─── KYC & Verification ───────────────────────────────────────────────────────

# Sandbox.co.in (Bank verification / Penny Drop)
SANDBOX_API_KEY=
SANDBOX_API_SECRET=

# ─── Communication Services ───────────────────────────────────────────────────

# Email (SMTP / Nodemailer)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=

# SMS & WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Object Storage ───────────────────────────────────────────────────────────
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=

# ─── Social / OAuth (Optional) ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_SERVICE_ID=
APPLE_TEAM_ID=

# ─── Market Data (Optional) ───────────────────────────────────────────────────
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=

# ─── Python Service (Optional) ────────────────────────────────────────────────
PYTHON_SERVICE_URL=
PYTHON_BIN=

# ─── KYC Vault — Broker Integrations ─────────────────────────────────────────
# Base eKYC Provider: "mock" (default, safe for all envs until KRA access confirmed)
#                     or "iris_kra" (once Section 3 compliance blocker is resolved)
BASE_EKYC_PROVIDER=mock

# IIFL Securities — update field names in /infra/broker-schemas/iifl.json
# after confirming API version (XTS vs ONT) with IIFL partner team
IIFL_API_KEY=
IIFL_API_SECRET=
IIFL_API_BASE_URL=https://api.iiflmarkets.com

# JM Financial — update field names after receiving JM Financial API documentation
JM_FINANCIAL_API_KEY=
JM_FINANCIAL_API_SECRET=
JM_FINANCIAL_API_BASE_URL=https://api.jmfinancial.in

# Alpaca Broker API (US equities) — paper = sandbox, production = live
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_ENV=paper
ALPACA_BROKER_API_BASE_URL=https://broker-api.sandbox.alpaca.markets/v1

# ─── Key Management (KMS) ─────────────────────────────────────────────────────
# GCP KMS key resource name for SSN/ITIN encryption (US fields)
# Format: projects/{project}/locations/{region}/keyRings/{ring}/cryptoKeys/{key}
# If not set, falls back to ENCRYPTION_MASTER_KEY (acceptable only in non-production)
KMS_KEY_ID=

# ─── Object Storage ───────────────────────────────────────────────────────────
# GCP Cloud Storage bucket for KYC documents (presigned URLs, 15-minute TTL)
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=

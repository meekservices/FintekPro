# ============================================================================
# FintekPro Environment Configuration
# ============================================================================
# Copy this file to .env and fill in the values for your environment
# DO NOT commit .env to version control - it contains sensitive credentials
# ============================================================================

# ----------------------------------------------------------------------------
# 🔧 SERVER CONFIGURATION
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5000
API_BASE_URL=http://localhost:5000

# ----------------------------------------------------------------------------
# 🔐 AUTHENTICATION & SECURITY
# ----------------------------------------------------------------------------
SESSION_SECRET=your-random-session-secret-min-32-chars
JWT_SECRET=your-random-jwt-secret-min-32-chars
CSRF_SECRET=your-random-csrf-secret-min-32-chars

# PAN Encryption (for KYC data protection)
PAN_ENCRYPTION_KEY=your-32-char-encryption-key

# Replit Authentication (auto-configured on Replit)
REPL_ID=
REPLIT_DOMAIN=
REPLIT_DOMAINS=
REPLIT_DEV_DOMAIN=
ISSUER_URL=

# ----------------------------------------------------------------------------
# 📊 DATABASE
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# ----------------------------------------------------------------------------
# 🏦 PAYMENT GATEWAYS
# ----------------------------------------------------------------------------

# Cashfree (Primary Payment Gateway)
CASHFREE_CLIENT_ID=your-cashfree-client-id
CASHFREE_CLIENT_SECRET=your-cashfree-client-secret
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret-key
CASHFREE_ENVIRONMENT=sandbox # or production

# PhonePe (Secondary Payment Gateway)
PHONEPE_MERCHANT_ID=your-phonepe-merchant-id
PHONEPE_SALT_KEY=your-phonepe-salt-key
PHONEPE_SALT_INDEX=1
PHONEPE_ENVIRONMENT=sandbox # or production

# Stripe (International Payments)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# ----------------------------------------------------------------------------
# 📧 COMMUNICATION SERVICES
# ----------------------------------------------------------------------------

# Email (SMTP - Nodemailer)
EMAIL_USER=your-smtp-email@example.com
EMAIL_PASS=your-smtp-password
EMAIL_SERVICE=gmail # or smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
SMS_API_KEY=your-sms-api-key # Alternative SMS provider
SMS_SENDER_ID=FINTEK
SMS_TEMPLATE_ID=your-template-id

# WhatsApp Business API
WHATSAPP_SESSION_PATH=./whatsapp-sessions
AISENSY_API_KEY=your-aisensy-api-key
AISENSY_PARTNER_KEY=your-aisensy-partner-key

# ----------------------------------------------------------------------------
# ✅ KYC & VERIFICATION SERVICES
# ----------------------------------------------------------------------------

# Sandbox.co.in (Primary KYC API - PAN, Aadhaar, Bank verification)
SANDBOX_API_KEY=your-sandbox-api-key
SANDBOX_API_SECRET=your-sandbox-api-secret

# Cashfree eKYC (Aadhaar verification)
# Uses same CASHFREE_CLIENT_ID and CASHFREE_CLIENT_SECRET above

# Digilocker (Backup Aadhaar verification)
DIGILOCKER_CLIENT_ID=your-digilocker-client-id
DIGILOCKER_CLIENT_SECRET=your-digilocker-client-secret
DIGILOCKER_REDIRECT_URI=https://yourapp.com/api/kyc/digilocker/callback

# eSign Services (Digital signature)
ESIGN_PROVIDER=emudhra # or nsdl
ESIGN_MODE=sandbox # or production
ESIGN_WEBHOOK_SECRET=your-esign-webhook-secret
EMUDHRA_CLIENT_ID=your-emudhra-client-id
EMUDHRA_CLIENT_SECRET=your-emudhra-client-secret
EMUDHRA_API_KEY=your-emudhra-api-key
EMUDHRA_WEBHOOK_SECRET=your-emudhra-webhook-secret
NSDL_ESIGN_API_KEY=your-nsdl-api-key
NSDL_ESIGN_CLIENT_ID=your-nsdl-client-id
NSDL_ESIGN_ENVIRONMENT=test # or production

# Video KYC Providers
HYPERVERGE_API_KEY=your-hyperverge-api-key
HYPERVERGE_API_SECRET=your-hyperverge-api-secret
HYPERVERGE_APP_ID=your-hyperverge-app-id
HYPERVERGE_API_URL=https://ind-verify.hyperverge.co/v2
HYPERVERGE_WORKFLOW_ID=your-workflow-id

SIGNDESK_API_KEY=your-signdesk-api-key
SIGNDESK_API_SECRET=your-signdesk-api-secret
SIGNDESK_API_URL=https://api.signdesk.in

SHUFTI_PRO_API_KEY=your-shufti-pro-api-key
SUMSUB_API_KEY=your-sumsub-api-key

# KRA (KYC Registration Agencies)
PROTEAN_KRA_API_KEY=your-protean-kra-api-key
PROTEAN_KRA_API_SECRET=your-protean-kra-api-secret
PROTEAN_KRA_API_URL=https://api.protean-tech.com

CAMS_KRA_API_KEY=your-cams-kra-api-key
CAMS_KRA_API_URL=https://api.camskra.com

KFINTECH_KRA_API_KEY=your-kfintech-kra-api-key
KFINTECH_KRA_API_URL=https://api.kfintech.com

NSE_KRA_API_KEY=your-nse-kra-api-key
NSE_KRA_API_URL=https://api.nsekra.com

NDML_KRA_API_KEY=your-ndml-kra-api-key
NDML_KRA_API_URL=https://api.ndmlkra.com

# CERSAI CKYC Service
CKYC_API_KEY=your-ckyc-api-key
CKYC_API_URL=https://ckyc.cersai.org.in/api
CKYC_INSTITUTION_CODE=your-institution-code

# AML/Sanction Screening
SANCTION_SCANNER_API_KEY=your-sanction-scanner-api-key

# ----------------------------------------------------------------------------
# 🏛️ BSE STAR MF API (Mutual Fund Trading)
# ----------------------------------------------------------------------------
BSE_ENVIRONMENT=sandbox # or production
BSE_MEMBER_ID=your-bse-member-id
BSE_USER_ID=your-bse-user-id
BSE_PASSWORD=your-bse-password
BSE_PASS_KEY=your-bse-pass-key

BSE_STAR_API_KEY=your-bse-star-api-key
BSE_STAR_API_URL=https://bsestarmf.in
BSE_STAR_MEMBER_ID=your-member-id
BSE_STAR_USER_ID=your-user-id

# BSE Accreditation API (SEBI Accredited Investor)
BSE_ACCREDITATION_API_KEY=your-accreditation-api-key
BSE_ACCREDITATION_API_URL=https://api.bseindia.com
BSE_ACCREDITATION_MEMBER_ID=your-member-id
BSE_ACCREDITATION_MODE=simulation # or production
BSE_ACCREDITATION_APPROVAL_DELAY=5000 # milliseconds
BSE_ACCREDITATION_STRICT_VALIDATION=true

# BSE Direct Equity API
BSE_DIRECT_ENVIRONMENT=sandbox
BSE_DIRECT_MEMBER_ID=your-direct-member-id
BSE_DIRECT_USER_ID=your-direct-user-id
BSE_DIRECT_PASSWORD=your-direct-password

# BSE Bond API
BSE_BOND_ENVIRONMENT=sandbox
BSE_BOND_MEMBER_ID=your-bond-member-id
BSE_BOND_USER_ID=your-bond-user-id
BSE_BOND_PASSWORD=your-bond-password

# ----------------------------------------------------------------------------
# 📈 NSE NCB API (Government Securities)
# ----------------------------------------------------------------------------
NSE_ENVIRONMENT=sandbox
NSE_MEMBER_ID=your-nse-member-id
NSE_USER_ID=your-nse-user-id
NSE_PASSWORD=your-nse-password

# ----------------------------------------------------------------------------
# 💼 MUTUAL FUND REGISTRAR APIS
# ----------------------------------------------------------------------------

# CAMS (Computer Age Management Services)
CAMS_API_KEY=your-cams-api-key
CAMS_BASE_URL=https://api.camsonline.com
CAMS_ENVIRONMENT=test
CAMS_MEMBER_ID=your-cams-member-id
CAMS_PASSWORD=your-cams-password

# KFintech
KFINTECH_API_URL=https://api.kfintech.com
KFINTECH_MEMBER_ID=your-kfintech-member-id
KFINTECH_USERNAME=your-username
KFINTECH_PASSWORD=your-password

# ----------------------------------------------------------------------------
# 🏦 BANKING APIs
# ----------------------------------------------------------------------------

# ICICI Bank
ICICI_BANK_API_KEY=your-icici-api-key
ICICI_BANK_APP_KEY=your-icici-app-key
ICICI_BANK_SECRET_KEY=your-icici-secret-key
ICICI_BANK_BASE_URL=https://api.icicibank.com
ICICI_BANK_ENVIRONMENT=sandbox

# HDFC Bank
HDFC_BANK_API_KEY=your-hdfc-api-key
HDFC_BANK_CLIENT_ID=your-hdfc-client-id
HDFC_BANK_CLIENT_SECRET=your-hdfc-client-secret
HDFC_BANK_BASE_URL=https://api.hdfcbank.com
HDFC_BANK_ENVIRONMENT=sandbox

# Interactive Brokers (for advanced trading)
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=0
IB_PAPER_TRADING=true

# ----------------------------------------------------------------------------
# 📊 MARKET DATA PROVIDERS
# ----------------------------------------------------------------------------

# Alpha Vantage (Stock market data)
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key

# Finnhub (Real-time market data)
FINNHUB_API_KEY=your-finnhub-api-key

# News API (Financial news)
NEWS_API_KEY=your-news-api-key

# JM Financial (Market data)
JM_FINANCIAL_API_KEY=your-jm-api-key
JM_FINANCIAL_MARKET_DATA_API_KEY=your-market-data-api-key

# ----------------------------------------------------------------------------
# 🤖 AI & MACHINE LEARNING
# ----------------------------------------------------------------------------

# Google Gemini (AI Chat Assistant, Portfolio Analysis)
GEMINI_API_KEY=your-gemini-api-key

# OpenAI (Alternative AI provider)
OPENAI_API_KEY=your-openai-api-key

# OpenAI AI Integrations (Replit integration)
AI_INTEGRATIONS_OPENAI_API_KEY=your-openai-key
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# ----------------------------------------------------------------------------
# 🏦 ACCOUNT AGGREGATOR FRAMEWORK
# ----------------------------------------------------------------------------
AA_PROVIDER=saafe # or finvu, onemoney, etc.
AA_ENVIRONMENT=sandbox
AA_FIU_ID=your-fiu-id
AA_FIU_NAME=FintekPro
AA_API_KEY=your-aa-api-key
AA_API_SECRET=your-aa-api-secret

# ----------------------------------------------------------------------------
# 💰 LOANS & NBFC INTEGRATIONS
# ----------------------------------------------------------------------------

# Bajaj Finance
BAJAJ_API_KEY=your-bajaj-api-key
BAJAJ_API_URL=https://api.bajajfinserv.in
BAJAJ_PARTNER_ID=your-partner-id

# Tata Capital
TATA_CAPITAL_API_KEY=your-tata-capital-api-key
TATA_CAPITAL_API_URL=https://api.tatacapital.com
TATA_CAPITAL_PARTNER_CODE=your-partner-code

# CIBIL (Credit reports)
CIBIL_MEMBER_ID=your-cibil-member-id
CIBIL_PASSWORD=your-cibil-password
CIBIL_API_KEY=your-cibil-api-key

# ----------------------------------------------------------------------------
# 🏛️ GOVERNMENT SERVICES
# ----------------------------------------------------------------------------

# NPS (National Pension System)
NPS_CRA_API_KEY=your-nps-cra-api-key
NPS_CRA_API_URL=https://npscra.nsdl.co.in/api

# APY (Atal Pension Yojana)
APY_API_KEY=your-apy-api-key
APY_API_URL=https://api.apy.gov.in

# EPFO (Employee Provident Fund)
EPFO_API_KEY=your-epfo-api-key
EPFO_API_URL=https://api.epfindia.gov.in

# BBPS (Bharat Bill Payment System)
BBPS_API_KEY=your-bbps-api-key
BBPS_API_URL=https://bbps.npci.org.in/api
BBPS_MERCHANT_ID=your-merchant-id

# TaxCloud / Income Tax APIs
TAXCLOUD_API_KEY=your-taxcloud-api-key
TAXCLOUD_BASE_URL=https://api.taxcloud.com
TAXCLOUD_ENVIRONMENT=sandbox

# ----------------------------------------------------------------------------
# 🛡️ INSURANCE
# ----------------------------------------------------------------------------
TURTLEFIN_API_KEY=your-turtlefin-api-key
TURTLEFIN_API_SECRET=your-turtlefin-api-secret

# ----------------------------------------------------------------------------
# 📋 CAS (Consolidated Account Statement)
# ----------------------------------------------------------------------------
CAS_PARSER_API_KEY=your-cas-parser-api-key
CAS_PARSER_URL=https://api.casparser.com
CAS_PARSER_EXTERNAL=false

# ----------------------------------------------------------------------------
# 📧 MARKETING AUTOMATION
# ----------------------------------------------------------------------------

# Zoho Campaigns (Email marketing)
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REDIRECT_URI=https://yourapp.com/api/zoho/callback
ZOHO_DATACENTER=com # or in, eu, au
ZOHO_WEBHOOK_SECRET=your-zoho-webhook-secret
ZOHO_CAMPAIGNS_ACCESS_TOKEN=
ZOHO_CAMPAIGNS_REFRESH_TOKEN=

# Probe42 (B2B company search)
PROBE42_API_KEY=your-probe42-api-key

# ----------------------------------------------------------------------------
# 🗄️ OBJECT STORAGE
# ----------------------------------------------------------------------------
PUBLIC_OBJECT_SEARCH_PATHS=/public
PRIVATE_OBJECT_DIR=/.private

# ----------------------------------------------------------------------------
# ⚡ PERFORMANCE & MONITORING
# ----------------------------------------------------------------------------

# Cache Configuration
CACHE_DEFAULT_TTL=3600 # seconds (1 hour)
CACHE_MAX_SIZE=1000 # max number of items

# Logging
LOG_LEVEL=info # debug, info, warn, error

# API Health Monitoring
API_HEALTH_MONITORING_ENABLED=true

# Alerting
ALERT_EMAIL_RECIPIENTS=alerts@fintekpro.com,admin@fintekpro.com
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# ----------------------------------------------------------------------------
# 📊 ADDITIONAL FEATURES
# ----------------------------------------------------------------------------

# Demat Holdings Service
DEMAT_API_KEY=your-demat-api-key

# NRI KYC Service
NRI_KYC_API_KEY=your-nri-kyc-api-key

# Corporate KYC
CORPORATE_KYC_API_KEY=your-corporate-kyc-api-key

# Capital Gains Calculator
CAPITAL_GAINS_API_KEY=your-capital-gains-api-key

# ----------------------------------------------------------------------------
# ⚙️ FEATURE FLAGS & SETTINGS
# ----------------------------------------------------------------------------
ENABLE_WEBSOCKET=true
ENABLE_REAL_TIME_PRICES=true
ENABLE_AI_FEATURES=true
ENABLE_PORTFOLIO_REBALANCING=true
ENABLE_AUTO_POPULATION=true
ENABLE_VIDEO_KYC=true
ENABLE_ESIGN=true

# ----------------------------------------------------------------------------
# 🔄 ENVIRONMENT-SPECIFIC OVERRIDES
# ----------------------------------------------------------------------------
# Production Environment:
# - Set NODE_ENV=production
# - Use production API endpoints
# - Enable all monitoring and alerting
# - Set higher rate limits
# - Enable HTTPS-only cookies
# - Configure CDN and static asset optimization

# Staging Environment:
# - Set NODE_ENV=staging
# - Use sandbox/test API endpoints
# - Enable monitoring but reduce alerting
# - Use test credentials

# Development Environment:
# - Set NODE_ENV=development
# - Use sandbox/test API endpoints
# - Disable external API calls if needed
# - Enable verbose logging

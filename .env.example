# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║           FintekPro — Master Environment Variables Reference             ║
# ║           Copy this file to .env and fill in the values.                ║
# ║           For GCP Cloud Run: use --set-secrets in gcp-deploy.sh         ║
# ║                                                                          ║
# ║  Priority Legend:                                                        ║
# ║    [P0-CRITICAL]  Production will fail without this                      ║
# ║    [P1-HIGH]      Core feature blocked without this                      ║
# ║    [P2-MEDIUM]    Partial degradation if missing                         ║
# ║    [P3-LOW]       Optional / rarely used                                 ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# ─────────────────────────────────────────────────────────────────────────────
# §1. DATABASE & INFRASTRUCTURE                         [P0-CRITICAL]
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL — GCP Cloud SQL connection string (production)
PRODUCTION_DATABASE_URL=

# PostgreSQL — local or fallback URL
DATABASE_URL=

# PostgreSQL raw credentials (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=fintekpro

# Cloud SQL Proxy (Cloud Run auto-connect)
# Format: project:region:instance-name
INSTANCE_CONNECTION_NAME=

# ─────────────────────────────────────────────────────────────────────────────
# §2. CACHE & SESSION                                   [P0-CRITICAL]
# ─────────────────────────────────────────────────────────────────────────────

# Redis — required for distributed compliance cache across Cloud Run pods.
# Without this, rate-limiter and KYC audit state diverge on autoscale.
# GCP: provision via Cloud Memorystore (Redis). Copy the private IP here.
# Format: redis://10.0.0.X:6379
REDIS_URL=

# ─────────────────────────────────────────────────────────────────────────────
# §3. SECURITY & ENCRYPTION                             [P0-CRITICAL]
# ─────────────────────────────────────────────────────────────────────────────

SESSION_SECRET=
ENCRYPTION_MASTER_KEY=
FIELD_ENCRYPTION_KEY=
KYC_ENCRYPTION_KEY=
PAN_ENCRYPTION_KEY=
JWT_SECRET=
JWT_MOBILE_SECRET=

# GCP KMS key for PAN/Aadhaar field-level encryption (SEBI compliance)
# Format: projects/PROJECT/locations/REGION/keyRings/RING/cryptoKeys/KEY
# If unset, falls back to ENCRYPTION_MASTER_KEY (not acceptable in production)
KMS_KEY_ID=

# SEBI-regulated compliance signing secret
COMPLIANCE_SECRET=

# Internal service-to-service auth token
INTERNAL_SERVICE_SECRET=
MIGRATION_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# §4. NODE RUNTIME                                      [P0-CRITICAL]
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=8080
LOG_LEVEL=info
NODE_TLS_REJECT_UNAUTHORIZED=1

# Boot behaviour flags
RUN_STARTUP_MIGRATIONS=false
RUN_BACKGROUND_SCHEDULERS=true

# ─────────────────────────────────────────────────────────────────────────────
# §5. AI / LLM CONNECTORS
# ─────────────────────────────────────────────────────────────────────────────

# Google Gemini — Primary AI engine for FASP-AI advisory [P0-CRITICAL]
GEMINI_API_KEY=
GOOGLE_AI_API_KEY=
AI_INTEGRATIONS_GOOGLE_API_KEY=

# OpenAI — GPT-4 based analysis                         [P1-HIGH]
OPENAI_API_KEY=

# Groq — Fast inference (LLaMA)                         [P2-MEDIUM]
GROQ_API_KEY=

# Anthropic — Claude models                             [P3-LOW]
ANTHROPIC_API_KEY=

# Cerebras — High-throughput inference                  [P3-LOW]
CEREBRAS_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# §6. PAYMENT GATEWAYS
# ─────────────────────────────────────────────────────────────────────────────

# --- Cashfree (Primary Payment Gateway) ---         [P0-CRITICAL]
# Used by: cashfree-service.ts, unified-payment-gateway.ts, kyc-flow-routes.ts
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENVIRONMENT=sandbox          # sandbox | production
CASHFREE_PG_APP_ID=
CASHFREE_PG_SECRET_KEY=
CASHFREE_PG_ENVIRONMENT=sandbox

# Cashfree — Payouts (salary / commission disbursement)
CASHFREE_PAYOUTS_APP_ID=
CASHFREE_PAYOUTS_SECRET_KEY=

# Cashfree — Auto-collect (UPI collection flows)
CASHFREE_AUTOCOLLECT_APP_ID=
CASHFREE_AUTOCOLLECT_SECRET_KEY=

# Cashfree — Subscriptions (SIP / recurring mandates)
CASHFREE_SUBSCRIPTIONS_APP_ID=
CASHFREE_SUBSCRIPTIONS_SECRET_KEY=

# Cashfree — Verification (penny-drop, bank verify)
CASHFREE_VERIFICATION_APP_ID=
CASHFREE_VERIFICATION_SECRET_KEY=


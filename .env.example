# Cashfree — Cross-border / LRS remittance
CASHFREE_CROSSBORDER_APP_ID=
CASHFREE_CROSSBORDER_SECRET_KEY=

# Cashfree — Client credentials (OAuth flows)
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=

# --- PhonePe ---                                    [P1-HIGH]
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=4
PHONEPE_ENVIRONMENT=sandbox           # sandbox | production

# --- Stripe (International / US payments) ---       [P2-MEDIUM]
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLIC_KEY=

# --- BBPS (Bharat Bill Payment System) ---          [P2-MEDIUM]
# Used by: bbpsService.ts, bbps-expense-integration.ts
BBPS_API_KEY=
BBPS_API_URL=https://api.bbps.org/v1
BBPS_MERCHANT_ID=


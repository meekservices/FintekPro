# Debug subdomain routing
DEBUG_SUBDOMAIN=false

# ─────────────────────────────────────────────────────────────────────────────
# §23. INFRASTRUCTURE / PLATFORM DETECTION
# ─────────────────────────────────────────────────────────────────────────────

# Replit (legacy, should not be set in GCP)
# REPLIT_DOMAIN=
# REPL_ID=

# Railway (legacy, not in use)
# RAILWAY_PUBLIC_DOMAIN=

# App domain
APP_DOMAIN=fintekpro.com
APP_BASE_URL=https://fintekpro.com
APP_URL=https://fintekpro.com
BASE_URL=https://fintekpro.com

# Puppeteer / Chromium path (if using headless PDF)
CHROMIUM_PATH=
PUPPETEER_EXECUTABLE_PATH=

# ─────────────────────────────────────────────────────────────────────────────
# §24. INSURANCE SERVICE                                [P3-LOW]
# ─────────────────────────────────────────────────────────────────────────────

INSURANCE_SERVICE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# §25. MCA / COMPANY FILINGS
# ─────────────────────────────────────────────────────────────────────────────

MCA_SYSTEM_ACCESS_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────

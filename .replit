modules = ["nodejs-20", "web", "python-3.11", "python3", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["atk", "chromium", "gdk-pixbuf", "glib", "glibcLocales", "gtk3", "libxcrypt", "nss", "pkg-config", "postgresql", "xsimd"]

[deployment]
deploymentTarget = "autoscale"
build = ["bash", "-c", "NODE_OPTIONS='--max-old-space-size=2048' npm run build"]
run = ["bash", "scripts/start-production.sh"]

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pkill -f 'supervisor.cjs' 2>/dev/null; pkill -f 'tsx server/index.ts' 2>/dev/null; sleep 1; fuser -k 5000/tcp 2>/dev/null; sleep 2; node supervisor.cjs"
waitForPort = 5000

[agent]
integrations = ["javascript_database:1.0.0", "javascript_openai:1.0.0", "javascript_websocket:1.0.0", "javascript_log_in_with_replit:1.0.0", "javascript_object_storage:2.0.0", "javascript_stripe:1.0.0", "javascript_gemini:1.0.0", "javascript_openai_ai_integrations:1.0.0", "twilio:1.0.0"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[[ports]]
localPort = 5002
externalPort = 3001

[[ports]]
localPort = 5003
externalPort = 3003

[[ports]]
localPort = 5004
externalPort = 3002

[[ports]]
localPort = 8001
externalPort = 4200

